# -----------------------------------------------------------------------------------------------
# Serendiva web (Next.js) — environment variables. Copy to .env.local and adjust.
#   PowerShell:  Copy-Item .env.example .env.local
#   (one-off override)  $env:NEXT_PUBLIC_API_URL="http://localhost:4000"; npm run dev
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time — never put secrets in them.
# -----------------------------------------------------------------------------------------------

# Public origin of this website (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API origin as seen from the BROWSER (forms POST here directly; must be allowed in the API's CORS_ORIGINS).
NEXT_PUBLIC_API_URL=http://localhost:4000

# API origin as seen from the Next.js SERVER (server components, sitemap, /api/v1 rewrite for the admin panel).
# Defaults to NEXT_PUBLIC_API_URL. Use an internal hostname in production if you have one.
API_URL=

# Shared secret for POST /api/revalidate (the API sends it as `x-revalidate-secret`). Same value as the API's
# REVALIDATE_SECRET, at least 16 characters. Generate one (cryptographically secure):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
REVALIDATE_SECRET=change-me-revalidate-secret-123

# Fallback WhatsApp number (digits only, international format, no +) used when the CMS settings have none.
NEXT_PUBLIC_WHATSAPP_NUMBER=94771234567

# Comma-separated locales offered in the language switcher (en, zh, de). Others show "coming soon".
# Example to enable German and Chinese in the switcher: NEXT_PUBLIC_ENABLED_LOCALES=en,de,zh
NEXT_PUBLIC_ENABLED_LOCALES=en

# Optional Cloudflare Turnstile site key. Leave empty to disable the widget (the API's TURNSTILE_SECRET must match).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# true = when the API is unreachable, serve the deprecated src/content snapshot (always on in `npm run dev`).
CONTENT_FALLBACK=false

# Extra image hosts allowed by next/image (comma list of hostnames, https only), e.g. a CDN or R2 public bucket.
IMAGE_REMOTE_HOSTS=

# E2E tests (npm run test:e2e)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PW_CHROMIUM_PATH=
